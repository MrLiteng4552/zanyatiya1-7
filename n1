// Задача 6
Console.Write("Введите температуру в градусах Цельсия: ");
double celsius = double.Parse(Console.ReadLine());
double fahrenheit = celsius * 9 / 5 + 32;
Console.WriteLine($"В Фаренгейтах: {fahrenheit}");

// Задача 7
Console.Write("Введите возраст в годах: ");
int years = int.Parse(Console.ReadLine());
int days = years * 365;
long hours = (long)days * 24;
long minutes = hours * 60;
Console.WriteLine($"Примерный возраст в днях: {days}");
Console.WriteLine($"В часах: {hours}");
Console.WriteLine($"В минутах: {minutes}");
