// Задача 5
Console.Write("Введите число N: ");
int n5 = int.Parse(Console.ReadLine());
int loopSum = 0;
for (int i = 1; i <= n5; i++)
{
    loopSum += i;
}
int formulaSum = n5 * (n5 + 1) / 2;
Console.WriteLine($"Сумма через цикл: {loopSum}");
Console.WriteLine($"Сумма через формулу: {formulaSum}");

// Задача 6
Console.Write("Введите целое число: ");
int num6 = Math.Abs(int.Parse(Console.ReadLine()));
int count = 0;
if (num6 == 0)
{
    count = 1;
}
else
{
    while (num6 > 0)
    {
        count++;
        num6 /= 10;
    }
}
Console.WriteLine($"Количество цифр: {count}");

// Задача 7
int secret = 42;
int attempts = 0;
int guess = 0;
while (guess != secret)
{
    Console.Write("Угадайте число: ");
    guess = int.Parse(Console.ReadLine());
    attempts++;
    if (guess < secret)
    {
        Console.WriteLine("Больше");
    }
    else if (guess > secret)
    {
        Console.WriteLine("Меньше");
    }
}
Console.WriteLine($"Вы угадали! Количество попыток: {attempts}");

// Задача 8
Console.Write("Введите число: ");
int num8 = int.Parse(Console.ReadLine());
bool isPrime = num8 > 1;
for (int i = 2; i <= Math.Sqrt(num8); i++)
{
    if (num8 % i == 0)
    {
        isPrime = false;
        break;
    }
}
if (isPrime)
{
    Console.WriteLine("Простое число");
}
else
{
    Console.WriteLine("Составное число");
}
